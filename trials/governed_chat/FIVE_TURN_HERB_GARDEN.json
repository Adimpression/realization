      ]
    },
    {
      "turn_id": "narrow_choice",
      "treatment": "follow_up",
      "prompt": "Reduce the plan to exactly two herbs while keeping my favorite. Restate the complete space, sunlight, and weekly-time constraints in the revised answer.",
