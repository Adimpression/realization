        {"label": "weekly time budget", "any_of": ["20 minutes", "twenty minutes"]},
        {"label": "sunlight", "any_of": ["sunny", "full sun"]},
        {"label": "balcony dimensions", "any_of": ["2m by 1m", "2 m by 1 m", "2m x 1m", "2 m x 1 m", "2-by-1"]},
