{
  "scenario_id": "five_turn_herb_garden",
  "description": "A bounded five-turn conversation that tests instruction following, retained constraints, correction, and final synthesis through explicit governed turn relationships.",
  "minimum_semantic_score": 1.0,
  "turns": [
    {
      "turn_id": "establish_plan",
      "treatment": "independent",
      "prompt": "Help me plan a tiny herb garden. I have a sunny 2m by 1m balcony, only 20 minutes a week, and basil is my favorite. Give me a concise three-bullet plan, and retain every constraint in the answer so we can refine it.",
      "required_concepts": [
        {"label": "favorite herb", "any_of": ["basil"]},
        {"label": "weekly time budget", "any_of": ["20 minutes", "twenty minutes"]},
