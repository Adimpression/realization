    },
    {
      "turn_id": "final_synthesis",
      "treatment": "follow_up",
      "prompt": "Summarize the final plan in two sentences. Include every current constraint and explicitly say that sunlight changed from sunny to partial sun.",
      "required_concepts": [
        {"label": "favorite herb", "any_of": ["basil"]},
