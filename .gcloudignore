# Repository metadata and local developer state.
.gcloudignore
.git
.git/**
.idea/**
.terraform/**
.venv/**
.uv-cache/**
venv/**
local.env
offline.env

# Generated language and build outputs.
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.dart_tool/**
**/.gradle/**
**/build/**
dist/**

# Runtime state and local databases.
**/.gcloud/**
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.tfstate
**/*.tfstate.*
ram/**
reports/**
state/**
tmp/**

# Editor and operating-system noise.
**/.DS_Store
**/*.sync-conflict-*
